{
  "name": "floraccess-api",
  "version": "2.8.0",
  "description": "Authentification API",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
    "dev-docker": "docker compose -f docker-compose.dev.yml up --build",
    "clean": "rm -rf dist",
    "clean-docker": "docker compose -f docker-compose.dev.yml down --volumes --rmi all",
    "lint": "echo true",
    "format:check": "echo true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloRobart/floraccess-api.git"
  },
  "keywords": [
    "authentication",
    "auth",
    "jwt",
    "api",
    "express",
    "typescript"
  ],
  "author": "Floris Robart",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/FloRobart/floraccess-api/issues"
  },
  "homepage": "https://github.com/FloRobart/floraccess-api#readme",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "install": "0.13.0",
    "nodemon": "3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "ms": "2.1.3",
    "node-cron": "4.6.0",
    "nodemailer": "10.4.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.1"
    },
    "swagger-jsdoc": {
      "glob": "^14.0.2"
    }
  }
}
