# Comments stay on their own line: after an empty value, Compose would read them as the value

# Application configuration
# Host (example: "localhost")
HOST_NAME=0.0.0.0
# Exposed port for FlorAccess API in development (example: 8080)
APP_PORT=26001
# URL where the API is available --> "http://${HOST_NAME}:${APP_PORT}"
BASE_URL="http://localhost:26001"
# Environment (dev, prod, silent) used to print more or less logs in console and expose Swagger endpoint
# Forced to prod by docker-compose.yml in production
APP_ENV=dev
# Format of the logs generated by morgan middleware (example: combined, common, dev, short, tiny)
LOG_FORMAT=combined

# Database
# Database scheme (postgresql, mysql, etc.)
DB_SCHEME=postgresql
# User for FlorAccess DB (same value as DB_USER in the floraccess-database repository)
# In production: floraccess_api, the role created by floraccess-database, which can only read and write the rows of the tables
DB_USER=floraccess
# Hostname of the database service in Docker network
DB_HOST=floraccess-database
# Database name for FlorAccess DB
DB_NAME=floraccess

# Email
# Email service provider (example: gmail)
MAIL_SERVICE=gmail
# Email account
MAIL_USERNAME=
# Minimum time between two error emails sent to the administrator, the errors in between are only written in the logs (example: 15min). If no unit is provided, ms is used.
ERROR_EMAIL_COOLDOWN=15min

# JWT
# Expiration time of the JWT token (example: 30d for 30 days) this value can be in ms, s, m, h, d. If no unit is provided, ms is used.
JWT_EXPIRATION=30d
# Maximum duration of a session since its login, even if its JWT is regenerated before it expires. After this duration the user has to log in again (example: 90d). If no unit is provided, ms is used.
SESSION_MAX_DURATION=90d

# Security
# Number of rounds used to hash passwords (example: 10)
HASH_ROUNDS=12
# Length of the token generated in characters (example: 256)
TOKEN_LENGTH=256
# Validity of the login code sent by email (example: 30min, 1h). If no unit is provided, seconds are used.
TOKEN_EXPIRATION=30min

# Authentication
# Default authentication method used for users (example: "EMAIL_CODE" or "PASSWORD")
DEFAULT_AUTH_METHOD=EMAIL_CODE
# Characters used to generate codes send by email at user login
CODE_DATA_SET=0123456789
# Number of confirmations allowed on one login code before it is invalidated (example: 5)
LOGIN_CODE_MAX_ATTEMPTS=5
# Minimum time between two login codes for the same user (example: 60s, 2min). If no unit is provided, seconds are used.
LOGIN_REQUEST_COOLDOWN=60s
# Time during which the logins are blocked when a user clicks on the block link of the login code email (example: 24h, 2d). If no unit is provided, seconds are used.
LOGIN_BLOCK_DURATION=24h

# Rate Limiting
# Number of requests allowed per second and per IP (example: 10)
REQUEST_LIMIT_PER_SECOND=10
# Time window to count requests in seconds (example: same value as JWT_EXPIRATION)
REQUEST_LIMIT_TIME=30min
# Number of requests allowed per IP on the registration, login and email verification routes during AUTH_REQUEST_LIMIT_TIME (example: 30)
AUTH_REQUEST_LIMIT=30
# Time window to count the requests limited by AUTH_REQUEST_LIMIT (example: 15min). If no unit is provided, ms is used.
AUTH_REQUEST_LIMIT_TIME=15min

# CORS
# List of allowed domains to make requests to the API (separated by commas)
# In development: Econoris app (26003), Econoris vitrine (26004) and FlorAccess app (26007)
CORS_ALLOWED_ORIGINS="http://localhost:26003,http://localhost:26004,http://localhost:26007"

# Secrets, development only. Commented out so they never reach a production .env:
# production reads them from files (see docker-compose.yml and README.md).
# In development, docker-compose.dev.yml gives DB_PASSWORD a default value.
# Password for FlorAccess DB
# DB_PASSWORD=postgres
# Password or App Password for the email account
# MAIL_PASSWORD=
# Secret key used to sign the JWT token. Required: there is no default key, the API does not start without it.
# In development, uncomment it with any value. Generate a production key with: openssl rand -hex 64
# JWT_SIGNING_KEY=
